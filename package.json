{
  "name": "liquid-glass-component",
  "version": "1.1.4",
  "description": "Real liquid glass for React. SVG feDisplacementMap refraction — not a blurred rectangle.",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "homepage": "https://exist08.github.io/liquid-glass-component/",
  "repository": {
    "type": "git",
    "url": "https://github.com/exist08/liquid-glass-component.git"
  },
  "bugs": {
    "url": "https://github.com/exist08/liquid-glass-component/issues"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "liquid-glass",
    "glassmorphism",
    "react",
    "react-component",
    "svg",
    "displacement",
    "refraction",
    "ui",
    "animation",
    "nextjs"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
